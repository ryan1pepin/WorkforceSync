<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>9c037f1d-de19-4a9c-b0a7-3a9e291f545f</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerComposeProjectPath>..\docker-compose.dcproj</DockerComposeProjectPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.2-preview.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkforceSync.Core\WorkforceSync.Core.csproj" />
    <ProjectReference Include="..\WorkforceSync.HcmSource\WorkforceSync.HcmSource.csproj" />
  </ItemGroup>

  <!-- Copy the built Angular app into the OUTPUT wwwroot so the API can serve it
       standalone. Target $(OutDir) (not the project wwwroot): the Web SDK only
       auto-copies wwwroot files that exist at evaluation time, and the frontend is
       generated during the build — so it must be placed directly in the output dir.
       $(OutDir) is bin/Debug/net10.0 for Debug and the publish dir for publish,
       which is exactly where Program.cs looks (AppContext.BaseDirectory + wwwroot). -->
  <Target Name="CopyFrontend" BeforeTargets="Build" Condition="Exists('..\frontend\dist\frontend\browser')">
    <ItemGroup>
      <FrontendFiles Include="..\frontend\dist\frontend\browser\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendFiles)" DestinationFolder="$(OutDir)wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
